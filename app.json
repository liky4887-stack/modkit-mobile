{
  "expo": {
    "name": "modkit-sandbox",
    "slug": "modkit-sandbox",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "modkitsandbox",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.modkit.sandbox"
    },
    "android": {
      "package": "com.modkit.sandbox",
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
