{
  "expo": {
    "name": "pubg-hack",
    "slug": "pubg-hack",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pubghack",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pubghack.tool"
    },
    "android": {
      "package": "com.pubghack.tool"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
